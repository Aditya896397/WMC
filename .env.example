# Copy to .env and adjust as needed.

# --- Backend --------------------------------------------------------------
# SQLite by default (file: database/smart_ambulance.db).
# DATABASE_URL=sqlite:///database/smart_ambulance.db
# Optional Supabase (Postgres) — requires: pip install "psycopg[binary]"
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Routing: set USE_OSRM=false to always use the built-in fallback route (offline demos)
USE_OSRM=true
OSRM_URL=https://router.project-osrm.org

# --- Frontend -------------------------------------------------------------
BACKEND_URL=http://localhost:8000
# BACKEND_WS_URL=ws://localhost:8000/ws/live
